{
  "schemaVersion": 1,
  "id": "shaders_mod_core",
  "version": "${version}",
  "depends": {
    "fishmodloader": ">=3.4.1"
  },
  "environment": "client",
  "name": "ShadersModCore",
  "description": "GL Shader Loader",
  "accessWidener": "shadersmodcore.accesswidener",
  "authors": [
    "Daxnitro",
    "karyonix",
    "Wensc",
    "Huix",
    "limingzxc",
    "Xy_Lose"
  ],
  "entrypoints": {
    "client": [
      "shadersmodcore.ShadersModCoreInit"
    ]
  },
  "mixins": [
    "shadersmodcore.mixin.json"
  ],
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/World": [
        "shadersmodcore/api/WorldAccessor"
      ]
    }
  }
}

